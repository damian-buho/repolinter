{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "pnpm",
  "plugins": [
    "@stryker-mutator/tap-runner",
    "@stryker-mutator/typescript-checker"
  ],
  "reporters": [
    "html",
    "json",
    "clear-text",
    "progress"
  ],
  "testRunner": "tap",
  "tap": {
    "testFiles": ["tests/**/*.ts"],
    "nodeArgs": ["--import", "tsx"]
  },
  "coverageAnalysis": "perTest",
  "timeoutMS": 6000,
  "timeoutFactor": 1.5,
  "buildCommand": "pnpm build",
  "ignorePatterns": [
    "tests/lib/symlink_for_test",
    "tests/rules/broken_symlink_for_test"
  ]
}
