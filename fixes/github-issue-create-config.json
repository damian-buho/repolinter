{
  "$schema": "http://json-schema.org/draft-07/schema",
  "$id": "https://raw.githubusercontent.com/damian-buho/repolinter/main/fixes/github-issue-create-config.json",
  "type": "object",
  "properties": {
    "issueLabels": {
      "type": "array",
      "items": { "type": "string" }
    },
    "bypassLabel": {
      "type": "string",
      "default": "CC: Bypass"
    },
    "issueTitle": {
      "type": "string"
    },
    "issueBody": {
      "type": "string"
    },
    "commentBody": {
      "type": "string"
    },
    "uniqueRuleId": {
      "type": "string"
    },
    "issueStatus": {
      "type": "string"
    }
  },
  "required": ["issueLabels", "issueTitle", "issueBody"]
}
