{
  "name": "@damian-buho/repolinter",
  "version": "2.0.0",
  "description": "Linter for open source repositories (fork of todogroup/repolinter)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "repolinter": "dist/cli.js"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js && cp rules/*-config.json dist/rules/ && cp fixes/*-config.json dist/fixes/ && cp -r rulesets/ dist/rulesets/",
    "prebuild": "rm -rf dist",
    "prepublishOnly": "npm run build",
    "pretest": "npm run lint",
    "test": "node --test 'tests/**/*.js'",
    "coverage": "node --test --experimental-test-coverage 'tests/**/*.js'",
    "lint": "eslint ./",
    "fix": "eslint ./ --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.js'",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.js'",
    "generate-docs": "typedoc"
  },
  "keywords": [
    "lint",
    "linter",
    "repository",
    "github",
    "license",
    "readme",
    "open source",
    "repolinter"
  ],
  "author": "The TODO Group",
  "contributors": [
    {
      "name": "Damián Búho",
      "email": "damian.buho@proton.me",
      "url": "https://dbuho.me"
    }
  ],
  "license": "Apache-2.0",
  "homepage": "https://damian-buho.github.io/repolinter/",
  "bugs": {
    "url": "https://github.com/damian-buho/repolinter/issues"
  },
  "repository": {
    "url": "git@github.com:damian-buho/repolinter.git",
    "type": "git"
  },
  "prettier": {
    "arrowParens": "avoid",
    "bracketSpacing": true,
    "printWidth": 80,
    "quoteProps": "as-needed",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false
  },
  "dependencies": {
    "ajv": "8.20.0",
    "asciidoctor": "3.0.4",
    "command-exists": "1.2.9",
    "find-config": "1.0.0",
    "gitlog": "5.1.0",
    "isbinaryfile": "6.0.0",
    "linguist-js": "2.9.2",
    "linkinator": "7.6.1",
    "matched": "5.0.1",
    "simple-git": "3.36.0",
    "spdx-license-list": "6.11.0",
    "yaml": "2.9.0",
    "yargs": "18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/eslint": "9.6.1",
    "@types/nock": "10.0.3",
    "@types/node": "25.9.1",
    "@types/yaml": "1.9.6",
    "@types/yargs": "17.0.35",
    "eslint": "10.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import-x": "4.16.2",
    "eslint-plugin-n": "18.0.1",
    "eslint-plugin-promise": "7.3.0",
    "eslint-plugin-tsdoc": "0.5.2",
    "eslint-plugin-unicorn": "64.0.0",
    "globals": "17.6.0",
    "markdown-toc": "1.2.0",
    "markdownlint": "0.40.0",
    "mock-http-server": "1.4.5",
    "nock": "14.0.15",
    "prettier": "3.8.3",
    "typedoc": "0.28.19",
    "typedoc-rhineai-theme": "1.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59.4"
  }
}
